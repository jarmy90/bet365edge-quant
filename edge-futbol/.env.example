# =============================================================================
# EDGE.FUTBOL - Twitter / X Auto-Publisher Bot Configuration
# =============================================================================

# Credenciales de Twitter/X (Requeridas para la primera sesión)
X_USERNAME=tu_usuario_o_handle
X_PASSWORD=tu_contrasena_de_x
X_EMAIL=tu_email_asociado@ejemplo.com

# URL de la API de oportunidades (+EV) de edge.futbol
EDGE_API_URL=https://edge.futbol/api/fixtures-hoy

# Configuración de comportamiento del bot
HEADLESS=true
MAX_POSTS_PER_RUN=1
POST_INTERVAL_HOURS=4
MIN_EDGE_PERCENT=3.0

# Ruta personalizada de Chrome/Edge (Opcional - vacía para autodetectar)
CHROME_PATH=

# =============================================================================
# MULTI-PROVIDER FREE LLM ROTATOR (ROUTING AUTOMÁTICO CON FAILOVER)
# =============================================================================
# NOTA: Puedes incluir múltiples API keys por proveedor separadas por coma para multiplicar la cuota free:
# Ejemplo: GEMINI_API_KEY=key1,key2,key3

# 1. Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# 2. Groq Cloud Free Tier (https://console.groq.com/)
GROQ_API_KEY=gsk_...

# 3. OpenRouter Free Tier (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# 4. Mistral AI Free Tier (https://console.mistral.ai/)
MISTRAL_API_KEY=...
